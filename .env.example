# Supabase API (optional — Auth/Storage later)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma → Supabase Postgres (direct connection — no pooler)
# Dashboard → Project Settings → Database → Connect → URI (Direct)
# URL-encode special characters in the password (e.g. & → %26)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true"
