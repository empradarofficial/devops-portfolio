generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Portfolio contact form submissions
model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  company   String?
  subject   String
  message   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "contact_created_at_idx")
  @@index([email], map: "contact_email_idx")
  @@map("contact")
}
